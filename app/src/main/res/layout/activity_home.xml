<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp"
    tools:context=".HomeActivity">

    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/catni_title"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <ImageView
        android:id="@+id/homeCatImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/cat"
        android:contentDescription="@string/cat_logo_desc"
        app:layout_constraintTop_toBottomOf="@id/homeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/welcomeGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_greeting"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/homeCatImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/horoscopeCardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/daily_horoscope_title"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#BBBBBB"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/welcomeGreeting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/horoscopeBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sample_horoscope"
        android:textSize="15sp"
        android:textColor="#DDDDDD"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:background="#1A1A1A"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/horoscopeCardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/logout_btn"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#222222"
        app:layout_constraintTop_toBottomOf="@id/horoscopeBody"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp" />

</androidx.constraintlayout.widget.ConstraintLayout>