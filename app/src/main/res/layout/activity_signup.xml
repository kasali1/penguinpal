<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/signupLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp"
    tools:context=".SignUpActivity">

    <TextView
        android:id="@+id/signupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/catni_title"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/signupSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signup_subtitle"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#BBBBBB"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/signupTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/catNameInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="@string/hint_cat_name"
        android:textColorHint="#777777"
        android:textColor="#FFFFFF"
        android:inputType="textPersonName"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/signupSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/sunSignInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="@string/hint_sun_sign"
        android:textColorHint="#777777"
        android:textColor="#FFFFFF"
        android:inputType="text"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/catNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/signupEmailInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="@string/hint_email"
        android:textColorHint="#777777"
        android:textColor="#FFFFFF"
        android:inputType="textEmailAddress"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/sunSignInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/signupPasswordInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="@string/hint_password"
        android:textColorHint="#777777"
        android:textColor="#FFFFFF"
        android:inputType="textPassword"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/signupEmailInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/submitSignupButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/create_account_btn"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/signupPasswordInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/signupBackToWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back_to_welcome"
        android:textSize="13sp"
        android:textColor="#888888"
        app:layout_constraintTop_toBottomOf="@id/submitSignupButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp" />

</androidx.constraintlayout.widget.ConstraintLayout>